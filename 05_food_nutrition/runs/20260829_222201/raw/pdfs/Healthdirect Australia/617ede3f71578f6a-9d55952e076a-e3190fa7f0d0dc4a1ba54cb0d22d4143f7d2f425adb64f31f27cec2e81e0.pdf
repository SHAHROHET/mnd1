        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M4.6875 10.7188C4.3125 11.125 3.65625 11.125 3.28125 10.7188C2.875 10.3438 2.875 9.6875 3.28125 9.3125L7.28125 5.3125C7.65625 4.90625 8.3125 4.90625 8.6875 5.3125L12.6875 9.3125C13.0938 9.6875 13.0938 10.3438 12.6875 10.7188C12.5 10.9062 12.25 11 12 11C11.7188 11 11.4688 10.9062 11.2812 10.7188L9 8.4375V14C9 14.5625 8.53125 15 8 15C7.4375 15 7 14.5625 7 14V8.4375L4.6875 10.7188ZM3 3C2.4375 3 2 2.5625 2 2C2 1.46875 2.4375 1 3 1H13C13.5312 1 14 1.46875 14 2C14 2.5625 13.5312 3 13 3H3Z" fill="currentColor"/>
        </svg>              
        <span class="hidden md:block text-sm font-semibold leading-[14px] tracking-[0.21px]">Back to top</span>
    </button>
  </div>

</div>

<div id="tailwind-modal-wrapper"></div>

  </div>

    

    <div
      id="campaign-video-lightbox"
      class="video-lightbox fixed inset-0 hidden z-[9999] bg-[rgba(0,0,0,0.7)] backdrop-blur-sm flex items-center justify-center p-4"
      aria-hidden="true"
    >
      <div class="relative w-full max-w-4xl shadow-2xl">
        <button
          id="campaign-video-close"
          type="button"
          class="absolute -top-10 right-0 z-10 text-[var(--color-audience-4)] hover:text-[var(--color-audience-7)] flex items-center justify-center focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-audience-4)]"
          data-video-close
          aria-label="Close video player"
        >
          <span aria-hidden="true" style="font-size: 54px;" class="block">&times;</span>
        </button>
        <div class="relative w-full bg-[var(--color-audience-7)] rounded" style="padding-top: 56.25%;">
          <iframe
            class="absolute inset-0 w-full h-full"
            referrerpolicy="origin-when-cross-origin"
            src=""
            title=""
            frameborder="0"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </div>
