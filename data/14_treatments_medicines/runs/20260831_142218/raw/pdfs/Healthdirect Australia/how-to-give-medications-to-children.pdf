                                            (function () {

                                                var url = window.location.href;
                                                var encodedUrl = encodeURIComponent(url);

                                                var fbLink = 'https://www.facebook.com/sharer/sharer.php?u=' + encodedUrl;
                                                var liLink = 'https://www.linkedin.com/sharing/share-offsite/?url=' + encodedUrl;
