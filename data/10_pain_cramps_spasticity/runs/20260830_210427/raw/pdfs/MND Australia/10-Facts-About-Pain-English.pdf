  document.querySelectorAll('.resource-cta').forEach(function (card) {
    const link = card.querySelector('a[href]');
    if (!link) return;

    // accessibility
    card.setAttribute('role', 'link');
    card.setAttribute('tabindex', '0');

    card.addEventListener('click', function (e) {
      // prevent conflicts with inner clickable elements
      if (e.target.closest('a, button, .dropdown, .modal, [role="button"]')) return;

      if (link.target === '_blank') {
        window.open(link.href, '_blank', 'noopener');
      } else {
        window.location.href = link.href;
      }
    });

    // keyboard support
    card.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        link.click();
      }
    });
  });
});</script><script data-optimized="1" async data-wp-strategy="async" id="add-to-calendar-button-js" src="https://als.ca/wp-content/litespeed/js/c5e706b50369406608cb93b50074cec4.js?ver=79c3b"></script> <script id="wp_ulike-js-before">var wp_ulike_params = {"ajax_url":"https:\/\/als.ca\/wp-admin\/admin-ajax.php","notifications":"0","ajax_error":"Could not save your vote. Please refresh the page and try again."};
