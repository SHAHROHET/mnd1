 <script>document.addEventListener('DOMContentLoaded', () => {
			try {
				// Normalize hostname (strip leading "www.")
				const hostname = window.location.hostname.replace(/^www\./, '');

				// ALS hostnames (prod + staging, EN + FR)
				const allowedHosts = [
					'als.ca',
					'sla-als.ca',
					'als-staging.innermostdigital.com',
					'fr-als-staging.innermostdigital.com',
				];

				// Exit if not on an allowed domain
				if (!allowedHosts.includes(hostname)) {
					return;
				}

				const url = new URL(window.location.href);

				// Remove only the GA linker parameter "_gl"
				if (url.searchParams.has('_gl')) {
					url.searchParams.delete('_gl');

					// Update URL without reloading the page
					window.history.replaceState({}, '', url.toString());
				}
			} catch {
				// Fail silently
			}
		});</script>  <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
